# Postgres connection string. Set automatically when you add Neon from the Vercel Marketplace.
DATABASE_URL=

# Random secret shared with the agent's config.json "deviceKey".
FOCUS_DEVICE_KEY=

# GitHub OAuth app (github.com/settings/developers). Callback: https://<your-app>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your numeric GitHub user ID (from https://api.github.com/users/<username>). Only this account can sign in.
GITHUB_ALLOWED_USER_ID=

# Random secret used to sign the login cookie. At least 32 characters.
SESSION_SECRET=

# Time zone used to decide what "today" is on the dashboard.
FOCUS_TIMEZONE=America/Los_Angeles
